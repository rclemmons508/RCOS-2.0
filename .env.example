# GEMINI_API_KEY: Required for Gemini AI API calls
# Get this from https://aistudio.google.com/app/apikeys
# DO NOT COMMIT YOUR ACTUAL KEY TO VERSION CONTROL
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (optional - auto-detected from google-services.json)
# FIREBASE_PROJECT_ID is loaded from google-services.json
# Only set these if you need to override the defaults
FIREBASE_PROJECT_ID=your-firebase-project-id
